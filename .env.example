# ============================================================================
# Reklam Agents — AI Farm Configuration
# ============================================================================
# Copy this file to .env and fill in the values you need.

# -----------------------------------------------------------------------------
# LLM Provider Keys (at least one required)
# Выберите один из доступных провайдеров ниже
# ========== OpenAI ==========
# OPENAI_API_KEY=sk-...

# ========== OpenRouter (прокси для множества моделей, доступен в России) ==========
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_API_KEY=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
# Поддерживает: OpenAI, Claude, Gemini, Mistral, Llama и др.

# ========== Groq (быстро, доступно в России) ==========
# GROQ_API_KEY=gsk-...
# GROQ_MODEL=mixtral-8x7b-32768

# ========== Together AI ==========
# TOGETHER_API_KEY=...
# TOGETHER_MODEL=meta-llama/Meta-Llama-3-70B-Instruct

# ========== Hugging Face Inference API ==========
# HF_API_KEY=hf_...
# HF_MODEL=mistralai/Mistral-7B-Instruct-v0.1

# ========== Anthropic Claude ==========
# ANTHROPIC_API_KEY=sk-ant-...

# ========== Google Gemini ==========
# GEMINI_API_KEY=...

# ========== Mistral AI ==========
# MISTRAL_API_KEY=...

# ========== GigaChat (Сбербанк, для России) ==========
# GIGACHAT_AUTH_KEY=MDE5Y2NkNmUtNzljYy03YzAyLTk0MDUtNGYwNGU2NzYxZWYwOjIxMGFjYTI0LWJkZGItNDFjYi1iMTk1LTY3N2RjMjQzNDE3YQ==
# GIGACHAT_MODEL=GigaChat  # или GigaChat-Pro
# Получайте Access token автоматически (система обновляет каждые 25 минут)

# ========== Yandex GPT (для России) ==========
# YANDEX_API_KEY=...
# YANDEX_FOLDER_ID=...

# ========== Ollama (локальное, полностью приватное) ==========
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=mistral

# Модели для использования
DEFAULT_MODEL=gpt-4o
# Fallback model (cheaper, for bulk tasks)
BULK_MODEL=gpt-4o-mini
# Strategy/reasoning model
STRATEGY_MODEL=gpt-4o

# -----------------------------------------------------------------------------
# Redis (required for message queue between agents)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# Vector Database (knowledge base for agent memory)
# -----------------------------------------------------------------------------
CHROMA_URL=http://localhost:8000
CHROMA_COLLECTION=reklam_knowledge

# -----------------------------------------------------------------------------
# Telegram Channel
# -----------------------------------------------------------------------------
# TELEGRAM_BOT_TOKEN=123456:ABCDEF...
# TELEGRAM_CHANNEL_ID=-100...

# -----------------------------------------------------------------------------
# Discord Channel
# -----------------------------------------------------------------------------
# DISCORD_BOT_TOKEN=...
# DISCORD_CHANNEL_ID=...

# -----------------------------------------------------------------------------
# SEO & Content
# -----------------------------------------------------------------------------
# BRAVE_SEARCH_API_KEY=...
# SERPER_API_KEY=...

# -----------------------------------------------------------------------------
# Farm Settings
# -----------------------------------------------------------------------------
FARM_NAME=ReklamFarm
FARM_MAX_CONCURRENT_AGENTS=20
FARM_CYCLE_INTERVAL_MS=300000
FARM_LOG_LEVEL=info

# Dashboard
DASHBOARD_PORT=3333
DASHBOARD_AUTH_TOKEN=change-me

# Sandbox for Programming Agents
SANDBOX_ENABLED=true
SANDBOX_TIMEOUT_MS=30000
SANDBOX_MAX_MEMORY_MB=512
