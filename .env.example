# ============================================================================
# Reklam Agents — AI Farm Configuration
# ============================================================================
# Copy this file to .env and fill in the values you need.

# -----------------------------------------------------------------------------
# LLM Provider Keys (at least one required)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-...
# For Russia/blocked regions, use OpenRouter as proxy:
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=...

# Default model for agents
DEFAULT_MODEL=gpt-4o
# Fallback model (cheaper, for bulk tasks)
BULK_MODEL=gpt-4o-mini
# Strategy/reasoning model
STRATEGY_MODEL=gpt-4o

# -----------------------------------------------------------------------------
# Redis (required for message queue between agents)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# Vector Database (knowledge base for agent memory)
# -----------------------------------------------------------------------------
CHROMA_URL=http://localhost:8000
CHROMA_COLLECTION=reklam_knowledge

# -----------------------------------------------------------------------------
# Telegram Channel
# -----------------------------------------------------------------------------
# TELEGRAM_BOT_TOKEN=123456:ABCDEF...
# TELEGRAM_CHANNEL_ID=-100...

# -----------------------------------------------------------------------------
# Discord Channel
# -----------------------------------------------------------------------------
# DISCORD_BOT_TOKEN=...
# DISCORD_CHANNEL_ID=...

# -----------------------------------------------------------------------------
# SEO & Content
# -----------------------------------------------------------------------------
# BRAVE_SEARCH_API_KEY=...
# SERPER_API_KEY=...

# -----------------------------------------------------------------------------
# Farm Settings
# -----------------------------------------------------------------------------
FARM_NAME=ReklamFarm
FARM_MAX_CONCURRENT_AGENTS=20
FARM_CYCLE_INTERVAL_MS=300000
FARM_LOG_LEVEL=info

# Dashboard
DASHBOARD_PORT=3333
DASHBOARD_AUTH_TOKEN=change-me

# Sandbox for Programming Agents
SANDBOX_ENABLED=true
SANDBOX_TIMEOUT_MS=30000
SANDBOX_MAX_MEMORY_MB=512
